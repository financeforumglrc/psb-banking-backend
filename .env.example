# DS Financial / PSB SecureWealth Twin — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# JWT secrets (generate strong random strings, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# SendGrid email OTP
# Get a free API key from https://sendgrid.com (free tier: 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=sdeepu70gg@gmail.com
SENDGRID_FROM_NAME=PSB SecureWealth

# SMTP fallback (used by emailService.js if SendGrid is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin credentials (required; no default password is accepted)
ADMIN_ID=TEAM EXCELLENT MINDS
ADMIN_PASSWORD=change-this-to-a-strong-random-password

# Demo MPIN for simulated UPI payments (6 digits, no default; set to enable simulation)
DEMO_MPIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Trust proxy (Render/Prod)
TRUST_PROXY=1

# PostgreSQL (Render free tier)
# Leave blank to use local SQLite. Set this to switch on Postgres persistence.
DATABASE_URL=

# Redis caching (optional; uses in-memory fallback if not set)
# Upstash/Render Redis URL: redis://... or rediss://...
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Razorpay test-mode payments
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Razorpay plan IDs for subscriptions (create plans in Razorpay dashboard)
RAZORPAY_PLAN_FREE=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_ENTERPRISE=

# Optional: AI provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# SETU Account Aggregator sandbox credentials (real AA integration)
# Get these from https://bridge.setu.co after creating an FIU + AA Data product.
# If left blank, the AA flow falls back to deterministic PSB mock data.
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_REDIRECT_URL=https://localhost:3000/aa/callback
SETU_PSB_FIP_ID=PSB-FIP-001
